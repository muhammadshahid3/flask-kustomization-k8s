# Copy this file to ".env" and change the values. NEVER commit the real .env file.

# --- PostgreSQL (used by the db service AND to build DATABASE_URL for the web service)
POSTGRES_DB=stockflow
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
# Tip: use only letters and digits in the password (special characters must be URL-encoded)

# --- Flask
SECRET_KEY=change_me_to_a_long_random_string

# --- Development admin account (created by `flask seed` when no admin exists yet)
# CHANGE THESE BEFORE PRODUCTION
ADMIN_NAME=Store Admin
ADMIN_EMAIL=admin@stockflow.local
ADMIN_PASSWORD=Admin@12345

# --- Load sample categories/products + the admin above on every start (safe to repeat).
# Set to false in production.
SEED_ON_START=true

# --- Optional: change the port on your machine (default 5000)
# WEB_PORT=5000
